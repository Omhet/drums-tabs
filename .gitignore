# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
app/dist/

# Per-song working data: audio and models are large and regenerable
songs/*/audio/
songs/*/stems/
songs/*/*.wav
songs/*/*.mp4
songs/*/*.webm
songs/*/debug/

# The sampler's bank, rendered out of a drum plugin you own by
# `drums kit-bake`. Large, regenerable, and not ours to redistribute -- the
# same reasoning as songs/*/stems/ above. kit.toml, which says what to render
# and how to play it, is tracked; none of what it produces is.
kit/samples/
kit/render/
kit/kit.lock.json

# Fonts and soundfonts copied out of node_modules by the alphaTab vite plugin;
# recreated by `npm run build` / `npm run dev`.
app/public/

# Screenshots the headless checks write. Regenerable, and a binary that
# changes on every run is not worth a diff.
app/shots/

# The latency calibration: a property of this machine's audio path, not of the
# project. Every take stamps the value it used, so takes stay comparable
# across machines without this being shared (practice-plan Q9).
calibration.local.json

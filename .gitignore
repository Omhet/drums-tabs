# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
app/dist/

# Per-song working data: audio and models are large and regenerable
songs/*/audio/
songs/*/stems/
songs/*/*.wav
songs/*/*.mp4
songs/*/*.webm
songs/*/debug/

# Fonts and soundfonts copied out of node_modules by the alphaTab vite plugin;
# recreated by `npm run build` / `npm run dev`.
app/public/

# The latency calibration: a property of this machine's audio path, not of the
# project. Every take stamps the value it used, so takes stay comparable
# across machines without this being shared (practice-plan Q9).
calibration.local.json
